# Optional: override the sqlite database path. Defaults to backend/app.db
# regardless of the directory the process is launched from.
# DATABASE_URL=sqlite:///./app.db
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash
# Instructions sent to the LLM with every request (global, applies to all conversations)
SYSTEM_PROMPT=You are a helpful assistant.
FRONTEND_ORIGIN=http://localhost:5173
# Authentication
# Signs login tokens. Use a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
